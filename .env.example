# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>

# Optional: use your own SMTP server instead of Resend. When EMAIL_SERVER is
# set it takes over and RESEND_API_KEY is not needed. URL-encode special
# characters in user and password (@ becomes %40).
# EMAIL_SERVER=smtps://login%40example.com:password@mail.example.com:465

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# Meta / Facebook Page (Messenger + Page comments). Confirmed against a real
# app: FACEBOOK_APP_ID is a separate numeric ID from INSTAGRAM_APP_ID, not
# shared.
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
# Business Login configuration ID (Meta App dashboard > Facebook Login for
# Business > Configuraciones > Crear configuración > "Token de acceso de
# usuario", with pages_show_list/pages_messaging/pages_manage_metadata/
# pages_read_engagement selected). Required instead of a plain OAuth `scope`
# param — a Page that lives inside a Meta Business Portfolio (rather than one
# a person administers via the legacy per-Page role system) doesn't show up
# from /me/accounts through the classic client_id+scope dialog even when the
# person has full Business Manager access to it. This config makes Meta show
# its own asset picker during authorization instead, which is what actually
# grants visibility.
FACEBOOK_LOGIN_CONFIG_ID=your-facebook-login-config-id

# LLM fallback for inbound DMs with no matching Automation keyword (see
# lib/ai/socialReply.ts). Optional — a workspace without Groq/OpenAI keys
# simply never gets a fallback reply, no matter its llmFallbackEnabled flags.
# Same provider-resolution convention as Rishtedar's lib/agent/runTurn.ts —
# Groq first if both are set.
AGENT_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
OPENAI_API_KEY=your-openai-api-key
